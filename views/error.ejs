<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7fb" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/error.css" />
    <script src="/js/error.js" defer></script>
  </head>
  <body>
    <main class="error-card" aria-labelledby="error-title">
      <div class="error-icon" aria-hidden="true">!</div>
      <p class="eyebrow">Something went wrong</p>
      <h1 id="error-title"><%= title %></h1>
      <p class="error-message">
        <%= typeof error === "string" ? error : error && error.message ? error.message : "An unexpected error occurred." %>
      </p>

      <div class="actions">
        <a class="button button-primary" href="/">Back to home</a>
        <button class="button button-secondary" type="button" data-retry>
          Try again
        </button>
      </div>

      <% if (error && typeof error === "object" && error.stack) { %>
      <details class="error-details">
        <summary>Technical details</summary>
        <pre><%= error.stack %></pre>
      </details>
      <% } %>
    </main>
  </body>
</html>
